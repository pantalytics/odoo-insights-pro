<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_blueprint" model="ir.module.category">
        <field name="name">Blueprint</field>
        <field name="description">Map the business and track implementation readiness on the company map.</field>
        <field name="parent_id" ref="base.module_category_services"/>
        <field name="sequence">40</field>
    </record>

    <record id="res_groups_privilege_blueprint" model="res.groups.privilege">
        <field name="name">Blueprint</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="module_category_blueprint"/>
    </record>

    <record id="group_blueprint_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">User: can open the company map, read the blueprint model (chains, processes, activities, scenarios) and read their own ADKAR scores.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_blueprint"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_blueprint_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Administrator: can edit the blueprint model, read and record everyone's ADKAR scores and notes, and import or export blueprints.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_blueprint"/>
        <field name="implied_ids" eval="[(4, ref('group_blueprint_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_blueprint_manager'))]"/>
    </record>

</odoo>
