<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ADKAR scores are personal: a Project user reads only the scores on their own
         contact, a Project administrator (the change manager) reads and edits all of them.
         People without a login are visible to administrators only. The company map gets
         one band word per role, over at least three people (models/adkar.py). -->
    <record id="rule_adkar_score_own" model="ir.rule">
        <field name="name">ADKAR score: own scores only</field>
        <field name="model_id" ref="model_pan_sl_adkar_score"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[Command.set([ref('project.group_project_user')])]"/>
    </record>

    <record id="rule_adkar_score_manager_all" model="ir.rule">
        <field name="name">ADKAR score: administrators see all scores</field>
        <field name="model_id" ref="model_pan_sl_adkar_score"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.set([ref('project.group_project_manager')])]"/>
    </record>
</odoo>
