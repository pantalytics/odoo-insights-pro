<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A role, and the people on it, is seen by whoever can see its project (#28):
         the same condition as Odoo's own project rule for internal users. A Project
         administrator sees every project, so every role. -->
    <record id="rule_role_project_visible" model="ir.rule">
        <field name="name">Blueprint role: visible with its project</field>
        <field name="model_id" ref="model_pan_sl_role"/>
        <field name="domain_force">['|',
                                        ('project_id.privacy_visibility', 'in', ['employees', 'portal']),
                                        ('project_id.message_partner_ids', 'in', [user.partner_id.id])
                                    ]</field>
        <field name="groups" eval="[Command.set([ref('project.group_project_user')])]"/>
    </record>

    <record id="rule_role_all" model="ir.rule">
        <field name="name">Blueprint role: project administrators see all</field>
        <field name="model_id" ref="model_pan_sl_role"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.set([ref('project.group_project_manager')])]"/>
    </record>
</odoo>
