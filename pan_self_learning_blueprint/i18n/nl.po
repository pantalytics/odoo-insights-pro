#. module: pan_self_learning_blueprint
#: model_terms:ir.actions.act_window,help:pan_self_learning_blueprint.action_process
msgid ""
"A process (level 2) groups the activities of one value chain, for example "
"\"Handle a quotation\"."
msgstr ""
"Een proces (niveau 2) groepeert de activiteiten van één waardeketen, "
"bijvoorbeeld \"Offerte afhandelen\"."

#. module: pan_self_learning_blueprint
#: model_terms:ir.actions.act_window,help:pan_self_learning_blueprint.action_scenario
msgid ""
"A scenario is a test route across processes: an ordered list of\n"
"                activities that together prove one way of working end to end."
msgstr ""
"Een scenario is een testroute over processen heen: een geordende lijst "
"activiteiten die samen één werkwijze van begin tot eind bewijzen."

