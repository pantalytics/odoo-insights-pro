<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pan_self_learning_blueprint.MapView">
        <div class="o_action o_pan_sl_map d-flex flex-column h-100" t-att-class="props.className" t-ref="root">
            <Layout display="props.display" className="'o_pan_sl_content'">
                <t t-set-slot="layout-actions">
                    <SearchBar toggler="searchBarToggler"/>
                </t>
                <t t-set-slot="control-panel-navigation-additional">
                    <t t-component="searchBarToggler.component" t-props="searchBarToggler.props"/>
                </t>
                <t t-if="!state.allowed">
                    <p class="o_pan_sl_empty text-muted m-3 p-4 text-center">The map needs access to Projects. Ask your administrator.</p>
                </t>
                <t t-elif="!projectId">
                    <p class="o_pan_sl_empty text-muted m-3 p-4 text-center">Open the map from a project.</p>
                </t>
                <t t-elif="state.data" t-call="pan_self_learning_blueprint.Map.Frame"/>
            </Layout>
        </div>
    </t>

    <!-- One zoomable stage; every element carries data-layer and shows only
         within its layer's zoom range (LAYERS in map_view.js). -->
    <t t-name="pan_self_learning_blueprint.Map.Frame">
        <div class="o_pan_sl_frame" t-att-data-zoom="level">
            <div class="o_pan_sl_toolbar">
                <nav class="o_pan_sl_crumbs" aria-label="Breadcrumb">
                    <t t-foreach="crumbs" t-as="crumb" t-key="crumb.zoom">
                        <span t-if="!crumb_first" class="o_pan_sl_crumb_sep" aria-hidden="true">›</span>
                        <span t-if="crumb_last" class="o_pan_sl_crumb_current" aria-current="location" t-esc="crumb.label"/>
                        <button t-else="" type="button" class="o_pan_sl_crumb btn btn-link" t-att-data-zoom="crumb.zoom"
                                t-on-click="() => this.zoomTo(crumb.zoom)" t-esc="crumb.label"/>
                    </t>
                </nav>
                <button t-if="show('unplaced') and unplaced.length" type="button" class="o_pan_sl_unplaced btn btn-link" data-layer="unplaced"
                        t-att-aria-pressed="isSelected('unplaced', 'all')" t-on-click="() => this.select('unplaced', 'all')">
                    <t t-esc="unplaced.length"/> <t t-if="unplaced.length === 1">task</t><t t-else="">tasks</t> without a place
                </button>
            </div>
            <div class="o_pan_sl_viewport">
                <div class="o_pan_sl_stage" t-ref="stage" t-on-wheel="onWheel"
                     t-on-touchstart="onTouchStart" t-on-touchmove="onTouchMove" t-on-touchend="onTouchEnd">
                    <div class="o_pan_sl_lod" t-attf-class="o_pan_sl_z{{ level }}" t-att-style="stageStyle">
                        <t t-call="pan_self_learning_blueprint.Map.Company"/>
                        <t t-if="show('flows')" t-call="pan_self_learning_blueprint.Map.Flows"/>
                        <t t-if="show('swimlane') and selectedFlow" t-call="pan_self_learning_blueprint.Map.Flow"/>
                    </div>
                </div>
                <t t-call="pan_self_learning_blueprint.Map.Panel"/>
            </div>
            <div t-if="!(show('task') and focusTask)" class="o_pan_sl_zoom" role="group" aria-label="Zoom">
                <button type="button" class="o_pan_sl_zoom_in btn" aria-label="Zoom in" t-att-disabled="!canZoomIn" t-on-click="zoomIn">
                    <i class="fa fa-plus" aria-hidden="true"/>
                </button>
                <button type="button" class="o_pan_sl_zoom_out btn" aria-label="Zoom out" t-att-disabled="!canZoomOut" t-on-click="zoomOut">
                    <i class="fa fa-minus" aria-hidden="true"/>
                </button>
            </div>
            <div class="visually-hidden o_pan_sl_status" role="status" aria-live="polite" t-esc="announcement"/>
        </div>
    </t>

    <!-- z0 and z1: the company, where it goes from and to, the timeline (z0) or
         the burn-up (z1) and the project's bar by step. -->
    <t t-name="pan_self_learning_blueprint.Map.Company">
        <t t-set="line" t-value="timeline"/>
        <t t-set="chart" t-value="show('burnup') and burnup"/>
        <section t-if="show('company')" class="o_pan_sl_company" data-layer="company" aria-label="Company">
            <h2 t-if="headline" class="o_pan_sl_headline" t-esc="headline"/>
            <ul t-if="state.data.project.keywords.length" class="o_pan_sl_keywords list-unstyled">
                <li t-foreach="state.data.project.keywords" t-as="word" t-key="word_index" t-esc="word"/>
            </ul>
            <div t-if="brief" class="o_pan_sl_brief" t-att-class="{ o_pan_sl_brief_open: state.briefOpen }">
                <div t-if="state.briefOpen" class="o_pan_sl_brief_text" t-out="brief"/>
                <button type="button" class="o_pan_sl_brief_more btn btn-link px-0" t-att-aria-expanded="state.briefOpen ? 'true' : 'false'"
                        t-on-click="() => this.state.briefOpen = !this.state.briefOpen">
                    <t t-if="state.briefOpen">Read less</t><t t-else="">Read more</t>
                </button>
            </div>
            <p t-if="missingTop" class="o_pan_sl_missing text-muted">Add the company in one page on the project</p>
        </section>
        <p t-if="show('systems') and systems" class="o_pan_sl_systems" data-layer="systems">
            <span t-esc="systems.from"/> <span class="o_pan_sl_systems_arrow" aria-hidden="true">→</span><span class="visually-hidden">to</span> <span t-esc="systems.to"/>
        </p>
        <button t-if="show('timeline') and line and !chart" type="button" class="o_pan_sl_timeline" data-layer="timeline"
                t-att-aria-label="line.start + ' – ' + line.end" t-on-click="(ev) => this.zoomTo(level + 1, { point: { x: ev.clientX, y: ev.clientY } })">
            <span class="o_pan_sl_timeline_track"/>
            <span class="o_pan_sl_timeline_edge o_pan_sl_timeline_start" t-esc="line.start"/>
            <span class="o_pan_sl_timeline_edge o_pan_sl_timeline_end" t-esc="line.end"/>
            <span t-foreach="line.ticks" t-as="tick" t-key="tick.id" class="o_pan_sl_tick"
                  t-att-class="{ o_pan_sl_tick_reached: tick.reached }"
                  t-attf-style="left: {{ tick.at }}%" t-att-title="tick.title">
                <span class="o_pan_sl_tick_mark"/>
                <span class="o_pan_sl_tick_label"><t t-esc="tick.name"/> <span class="text-muted" t-esc="tick.date"/></span>
            </span>
            <span class="o_pan_sl_today" t-attf-style="left: {{ line.today }}%"><span>Today</span></span>
        </button>
        <figure t-if="chart" class="o_pan_sl_burnup" data-layer="burnup" role="img" t-att-aria-label="chart.label">
            <div class="o_pan_sl_burnup_plot">
                <svg class="o_pan_sl_burnup_svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                    <line class="o_pan_sl_burnup_rule" x1="0" y1="0" x2="100" y2="0"/>
                    <line class="o_pan_sl_burnup_rule" x1="0" y1="100" x2="100" y2="100"/>
                    <line class="o_pan_sl_burnup_now" t-att-x1="chart.today" y1="0" t-att-x2="chart.today" y2="100"/>
                    <polyline class="o_pan_sl_burnup_ideal" t-att-points="chart.ideal"/>
                    <polyline class="o_pan_sl_burnup_actual" t-att-points="chart.actual"/>
                </svg>
                <span class="o_pan_sl_burnup_y o_pan_sl_burnup_y_top" aria-hidden="true">100%</span>
                <span class="o_pan_sl_burnup_y o_pan_sl_burnup_y_bottom" aria-hidden="true">0%</span>
                <span t-foreach="chart.ticks" t-as="tick" t-key="tick.id" class="o_pan_sl_burnup_tick"
                      t-att-class="{ o_pan_sl_burnup_tick_reached: tick.reached }" t-attf-style="left: {{ tick.at }}%" t-att-title="tick.title"/>
                <span class="o_pan_sl_burnup_end" t-attf-style="left: {{ chart.end.x }}%; top: {{ chart.end.y }}%"/>
                <span class="o_pan_sl_burnup_value" t-attf-style="left: {{ chart.end.x }}%; top: {{ chart.end.y }}%" t-esc="chart.end.label"/>
                <span class="o_pan_sl_burnup_today" t-attf-style="left: {{ chart.today }}%">Today</span>
            </div>
            <div class="o_pan_sl_burnup_axis" aria-hidden="true">
                <span t-esc="chart.start"/>
                <span t-esc="chart.target"/>
            </div>
        </figure>
        <t t-if="show('projectBar')">
            <t t-set="summary" t-value="project"/>
            <button type="button" class="o_pan_sl_project_bar" data-layer="projectBar" t-att-aria-label="summary.label"
                    t-on-click="(ev) => this.zoomTo(2, { point: { x: ev.clientX, y: ev.clientY } })">
                <span class="o_pan_sl_stack">
                    <span t-foreach="summary.parts" t-as="part" t-key="part.tone"
                          t-attf-class="o_pan_sl_tone_{{ part.tone }}" t-attf-style="flex-grow: {{ part.count }}"/>
                </span>
            </button>
            <p t-if="show('caption')" class="o_pan_sl_caption" data-layer="caption">
                <span class="o_pan_sl_caption_milestone" t-esc="summary.milestone"/>
                <span class="o_pan_sl_caption_status" t-attf-class="o_pan_sl_status_{{ summary.tone }}">
                    <span class="o_pan_sl_dot" t-attf-class="o_pan_sl_status_dot_{{ summary.tone }}"/>
                    <t t-esc="summary.status"/>
                </span>
            </p>
        </t>
        <ul t-if="show('legend')" class="o_pan_sl_legend list-unstyled" data-layer="legend" aria-label="Legend">
            <li t-foreach="tones" t-as="item" t-key="item.tone">
                <span class="o_pan_sl_dot" t-attf-class="o_pan_sl_tone_{{ item.tone }}"/>
                <t t-esc="item.label"/>
            </li>
        </ul>
    </t>

    <!-- z2: every flow as a bar by step, a one-line summary and up to three keywords. Worst first. -->
    <t t-name="pan_self_learning_blueprint.Map.Flows">
        <ol t-if="state.data.flows.length" class="o_pan_sl_flow_rows list-unstyled" data-layer="flows" aria-label="Flows">
            <li t-foreach="state.data.flows" t-as="flow" t-key="flow.id">
                <button type="button" class="o_pan_sl_flow" t-att-data-flow-id="flow.id"
                        t-att-aria-current="flow.id === state.flowId ? 'true' : undefined" t-on-click="(ev) => this.flyToFlow(flow.id, ev)">
                    <span class="o_pan_sl_flow_name" t-att-title="flow.name" t-esc="flow.name"/>
                    <span class="o_pan_sl_stack" aria-hidden="true">
                        <span t-foreach="parts(flowTasks(flow))" t-as="part" t-key="part.tone"
                              t-attf-class="o_pan_sl_tone_{{ part.tone }}" t-attf-style="flex-grow: {{ part.count }}"/>
                    </span>
                    <span class="o_pan_sl_flow_open" t-esc="flow.open_count ? openLabel(flow) : ''"/>
                    <span class="o_pan_sl_due" t-esc="deadline(flow)"/>
                    <span class="o_pan_sl_late" t-esc="flow.late ? lateLabel(flow) : ''"/>
                    <span class="o_pan_sl_flow_summary" t-att-title="flow.summary or ''">
                        <t t-esc="flow.summary or ''"/>
                        <span t-foreach="flow.keywords" t-as="word" t-key="word_index" class="o_pan_sl_keyword" t-esc="word"/>
                    </span>
                </button>
            </li>
        </ol>
        <p t-else="" class="o_pan_sl_empty text-muted m-3 p-4 text-center" data-layer="flows">No flows yet.</p>
    </t>

    <!-- z3 and z4: one flow, its steps beside its swimlane. -->
    <t t-name="pan_self_learning_blueprint.Map.Flow">
        <div class="o_pan_sl_detail" data-fly="flow">
            <nav t-if="show('steps')" class="o_pan_sl_flows" data-layer="steps" aria-label="Steps">
                <div class="o_pan_sl_flow_head">
                    <span class="o_pan_sl_flow_name" t-esc="selectedFlow.name"/>
                    <span t-if="selectedFlow.summary" class="o_pan_sl_flow_summary" t-esc="selectedFlow.summary"/>
                    <span class="o_pan_sl_stack" aria-hidden="true">
                        <span t-foreach="parts(flowTasks(selectedFlow))" t-as="part" t-key="part.tone"
                              t-attf-class="o_pan_sl_tone_{{ part.tone }}" t-attf-style="flex-grow: {{ part.count }}"/>
                    </span>
                    <span class="o_pan_sl_flow_meta">
                        <span t-if="selectedFlow.open_count" class="o_pan_sl_flow_open" t-esc="openLabel(selectedFlow)"/>
                        <span t-if="selectedFlow.deadline" class="o_pan_sl_due" t-esc="deadline(selectedFlow)"/>
                        <span t-if="selectedFlow.late" class="o_pan_sl_late" t-esc="lateLabel(selectedFlow)"/>
                    </span>
                </div>
                <ul class="o_pan_sl_open_tasks list-unstyled">
                    <li t-foreach="listedTasks" t-as="task" t-key="task.id">
                        <button type="button" class="o_pan_sl_open_task" t-att-class="{ o_pan_sl_step_done: isDone(task) }"
                                t-att-data-task-id="task.id" t-on-click="(ev) => this.flyToTask(task, ev)">
                            <span class="o_pan_sl_dot" t-attf-class="o_pan_sl_tone_{{ toneOf(task) }}"/>
                            <span>
                                <span class="d-block" t-esc="task.name"/>
                                <span t-if="isDone(task)" class="o_pan_sl_step_word d-block" t-esc="progressWord(task)"/>
                                <span class="o_pan_sl_owners d-block text-muted" t-esc="owners(task)"/>
                                <span class="o_pan_sl_hours d-block text-muted" t-esc="hours(task)"/>
                            </span>
                        </button>
                    </li>
                    <li t-if="!listedTasks.length" class="text-muted px-2">No tasks.</li>
                </ul>
            </nav>
            <div class="o_pan_sl_grid_wrap" data-layer="swimlane" t-att-class="{ o_pan_sl_fade_right: fade.right }">
                <div class="o_pan_sl_grid_area" t-ref="gridArea" t-on-scroll="updateFade">
                    <div t-if="rows.length" t-key="'flow-' + state.flowId" t-ref="grid" class="o_pan_sl_grid o_pan_sl_swimlane"
                         role="table" t-att-aria-label="selectedFlow.name" t-att-style="gridStyle">
                        <svg class="o_pan_sl_arrows" aria-hidden="true" focusable="false" t-att-width="arrows.width" t-att-height="arrows.height">
                            <defs>
                                <marker t-att-id="markerId" viewBox="0 0 10 10" refX="9" refY="5"
                                        markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                                    <path d="M0,0 L10,5 L0,10 z" fill="currentColor"/>
                                </marker>
                            </defs>
                            <path t-foreach="arrows.paths" t-as="path" t-key="path.key" class="o_pan_sl_arrow"
                                  t-att-d="path.d" t-att-data-from="path.from" t-att-data-to="path.to"
                                  t-att-marker-end="'url(#' + markerId + ')'"/>
                        </svg>
                        <div class="o_pan_sl_corner" role="columnheader"/>
                        <div t-foreach="headers" t-as="header" t-key="header.key" class="o_pan_sl_phase" role="columnheader"
                             t-att-style="header.span > 1 ? 'grid-column: span ' + header.span : undefined" t-esc="header.name"/>
                        <t t-foreach="rows" t-as="row" t-key="row.role.id">
                            <button type="button" class="o_pan_sl_role" role="rowheader" t-att-data-role-id="row.role.id"
                                    t-att-aria-pressed="isSelected('role', row.role.id)"
                                    t-on-click="() => this.select('role', row.role.id)" t-esc="row.role.name"/>
                            <div t-foreach="row.cells" t-as="cell" t-key="cell.key" class="o_pan_sl_cell" role="cell">
                                <t t-foreach="cell.tasks" t-as="task" t-key="task.id">
                                    <t t-call="pan_self_learning_blueprint.Map.Chip"/>
                                </t>
                            </div>
                        </t>
                    </div>
                    <p t-else="" class="o_pan_sl_empty text-muted m-3 p-4 text-center">No task of this flow has a role and a phase yet.</p>
                </div>
            </div>
        </div>
    </t>

    <t t-name="pan_self_learning_blueprint.Map.Chip">
        <button type="button" class="o_pan_sl_chip" t-att-data-task-id="task.id" t-att-aria-label="chipLabel(task)"
                t-att-title="task.name" t-att-aria-pressed="task.id === state.taskId and level >= 4 ? 'true' : 'false'"
                t-on-click="(ev) => this.flyToTask(task, ev)">
            <span class="o_pan_sl_dot" t-attf-class="o_pan_sl_tone_{{ toneOf(task) }}"/>
            <span class="o_pan_sl_chip_name" t-esc="task.name"/>
        </button>
    </t>

    <!-- z4: the task in focus; or, at any level, a role or the tasks without a place. -->
    <t t-name="pan_self_learning_blueprint.Map.Panel">
        <t t-set="task" t-value="show('task') ? focusTask : null"/>
        <t t-set="role" t-value="selectedRole"/>
        <section t-if="state.selected and state.selected.type === 'unplaced'" class="o_pan_sl_panel o_pan_sl_unplaced_panel" aria-label="Without a place">
            <t t-call="pan_self_learning_blueprint.Map.PanelHead"><t t-set="title">Without a place</t></t>
            <div class="o_pan_sl_cell_tasks">
                <t t-foreach="unplaced" t-as="task" t-key="task.id">
                    <t t-call="pan_self_learning_blueprint.Map.Chip"/>
                </t>
            </div>
        </section>
        <section t-elif="role" class="o_pan_sl_panel o_pan_sl_role_panel" aria-label="Role">
            <t t-call="pan_self_learning_blueprint.Map.PanelHead"><t t-set="title" t-value="role.name"/></t>
            <h3 class="o_pan_sl_panel_label">People</h3>
            <ul t-if="role.people.length" class="o_pan_sl_role_people list-unstyled">
                <li t-foreach="role.people" t-as="person" t-key="person_index" t-esc="person"/>
            </ul>
            <p t-else="" class="text-muted">Nobody in this role yet.</p>
            <h3 class="o_pan_sl_panel_label">To train on</h3>
            <ul t-if="roleTraining(role).length" class="o_pan_sl_role_training list-unstyled">
                <li t-foreach="roleTraining(role)" t-as="item" t-key="item.id">
                    <button type="button" class="o_pan_sl_open_task" t-on-click="(ev) => this.flyToTask(item, ev)">
                        <span class="o_pan_sl_dot" t-attf-class="o_pan_sl_tone_{{ toneOf(item) }}"/>
                        <span t-esc="item.name"/>
                    </button>
                </li>
            </ul>
            <p t-else="" class="text-muted">Nothing left to train.</p>
            <button type="button" class="o_pan_sl_training btn btn-link px-0" t-on-click="onTraining">Still to train, all roles</button>
            <h3 class="o_pan_sl_panel_label">ADKAR</h3>
            <p class="o_pan_sl_role_adkar" t-esc="adkarWord(role)"/>
        </section>
        <BlueprintTaskPanel t-elif="task" resId="task.id" context="taskContext" beforeLeave="taskLeave"
                            onOpen="() => this.openTask(task)" onClose="() => this.zoomOut()"/>
    </t>

    <t t-name="pan_self_learning_blueprint.Map.PanelHead">
        <div class="d-flex align-items-start gap-2 mb-2">
            <h2 class="o_pan_sl_panel_title flex-grow-1 m-0" t-out="title"/>
            <button type="button" class="o_pan_sl_close btn btn-link" aria-label="Close" t-on-click="() => this.state.selected = null">
                <i class="fa fa-times" aria-hidden="true"/>
            </button>
        </div>
    </t>

</templates>
