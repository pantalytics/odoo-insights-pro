<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pan_self_learning_blueprint.TaskPanel">
        <section class="o_pan_sl_panel o_pan_sl_task_panel" aria-label="Task">
            <div class="o_pan_sl_panel_bar">
                <button type="button" class="o_pan_sl_expand btn btn-link" title="Open full screen" aria-label="Open full screen"
                        t-on-click="() => props.onOpen()">
                    <i class="fa fa-expand" aria-hidden="true"/>
                </button>
                <button type="button" class="o_pan_sl_close btn btn-link" title="Close" aria-label="Close"
                        t-on-click="() => props.onClose()">
                    <i class="fa fa-times" aria-hidden="true"/>
                </button>
            </div>
            <View t-props="viewProps" t-key="props.resId"/>
        </section>
    </t>

</templates>
