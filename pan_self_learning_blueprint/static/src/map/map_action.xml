<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pan_self_learning_blueprint.MapList">
        <div class="o_action o_pan_sl_map o_pan_sl_map_list d-flex flex-column h-100">
            <Layout display="{ controlPanel: {} }">
                <ul t-if="state.projects.length" class="o_pan_sl_projects list-unstyled m-3">
                    <li t-foreach="state.projects" t-as="project" t-key="project.id">
                        <button type="button" class="o_pan_sl_project btn btn-link" t-on-click="() => this.open(project)" t-esc="project.name"/>
                    </li>
                </ul>
                <p t-else="" class="o_pan_sl_empty text-muted m-3 p-4 text-center">No project has a map yet.</p>
            </Layout>
        </div>
    </t>

</templates>
