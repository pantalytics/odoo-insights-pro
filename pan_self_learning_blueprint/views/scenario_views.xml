<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pan_sl_scenario_list" model="ir.ui.view">
        <field name="name">pan.sl.scenario.list</field>
        <field name="model">pan.sl.scenario</field>
        <field name="arch" type="xml">
            <list string="Scenarios">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description" optional="hide"/>
                <field name="rung" optional="show"/>
                <field name="task_count" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_pan_sl_scenario_form" model="ir.ui.view">
        <field name="name">pan.sl.scenario.form</field>
        <field name="model">pan.sl.scenario</field>
        <field name="arch" type="xml">
            <form string="Scenario">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Make to order, delivered and invoiced"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="rung"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Route" name="steps">
                            <field name="step_ids" context="{'default_scenario_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="activity_id"/>
                                    <field name="role_id" optional="show"/>
                                    <field name="phase_id" optional="show"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Goal" name="goal">
                            <group>
                                <field name="description" placeholder="What this scenario proves when it runs end to end"/>
                                <field name="open_point" placeholder="What still has to be checked"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pan_sl_scenario_search" model="ir.ui.view">
        <field name="name">pan.sl.scenario.search</field>
        <field name="model">pan.sl.scenario</field>
        <field name="arch" type="xml">
            <search string="Scenarios">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="step_ids" string="Activity" filter_domain="[('step_ids.activity_id', 'ilike', self)]"/>
                <filter string="With Open Point" name="with_open_point" domain="[('open_point', '!=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_scenario" model="ir.actions.act_window">
        <field name="name">Scenarios</field>
        <field name="res_model">pan.sl.scenario</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pan_sl_scenario_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a scenario</p>
            <p>A scenario is a test route across processes: an ordered list of
                activities that together prove one way of working end to end.</p>
        </field>
    </record>

</odoo>
