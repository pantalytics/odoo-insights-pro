<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Phases (map columns, shared by all projects) -->
    <record id="view_phase_list" model="ir.ui.view">
        <field name="name">pan.sl.phase.list</field>
        <field name="model">pan.sl.phase</field>
        <field name="arch" type="xml">
            <list string="Phases">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_phase_form" model="ir.ui.view">
        <field name="name">pan.sl.phase.form</field>
        <field name="model">pan.sl.phase</field>
        <field name="arch" type="xml">
            <form string="Phase">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Quotation"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. quotation"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_phase" model="ir.actions.act_window">
        <field name="name">Phases</field>
        <field name="res_model">pan.sl.phase</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first phase</p>
        </field>
    </record>

    <!-- Roles (map rows, per project) -->
    <record id="view_role_list" model="ir.ui.view">
        <field name="name">pan.sl.role.list</field>
        <field name="model">pan.sl.role</field>
        <field name="arch" type="xml">
            <list string="Roles">
                <field name="sequence" widget="handle"/>
                <field name="project_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="is_external"/>
                <field name="partner_ids" widget="many2many_tags_avatar" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_role_form" model="ir.ui.view">
        <field name="name">pan.sl.role.form</field>
        <field name="model">pan.sl.role</field>
        <field name="arch" type="xml">
            <form string="Role">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sales"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="code" placeholder="e.g. sales"/>
                        </group>
                        <group>
                            <field name="is_external"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="People" name="people" invisible="is_external">
                            <field name="partner_ids" widget="many2many_tags_avatar"/>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="What this role is responsible for."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_role_search" model="ir.ui.view">
        <field name="name">pan.sl.role.search</field>
        <field name="model">pan.sl.role</field>
        <field name="arch" type="xml">
            <search string="Roles">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="project_id"/>
                <field name="partner_ids"/>
                <filter string="External" name="external" domain="[('is_external', '=', True)]"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_role" model="ir.actions.act_window">
        <field name="name">Roles</field>
        <field name="res_model">pan.sl.role</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_role_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first role, or load the template from a project</p>
        </field>
    </record>
</odoo>
