<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The map is a view type on project.task (2.3): "Map" in a project's view
         switcher, with Odoo's own search bar. -->
    <record id="view_task_map" model="ir.ui.view">
        <field name="name">project.task.map</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <pan_blueprint string="Map"/>
        </field>
    </record>

    <record id="act_project_task_map_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="15"/>
        <field name="view_mode">pan_blueprint</field>
        <field name="view_id" ref="view_task_map"/>
        <field name="act_window_id" ref="project.act_project_project_2_project_task_all"/>
    </record>

    <!-- Projects > Map: opens the one mapped project in the Map view, or a plain
         list of mapped projects. Also takes old map URLs (params project_id). -->
    <record id="action_blueprint_map" model="ir.actions.client">
        <field name="name">Map</field>
        <field name="tag">pan_sl_blueprint_map</field>
    </record>
</odoo>
