<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== Process (L2) ===================== -->

    <record id="view_pan_sl_process_list" model="ir.ui.view">
        <field name="name">pan.sl.process.list</field>
        <field name="model">pan.sl.process</field>
        <field name="arch" type="xml">
            <list string="Processes">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="chain_id"/>
                <field name="owner_role_id" optional="show"/>
                <field name="activity_count" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_pan_sl_process_form" model="ir.ui.view">
        <field name="name">pan.sl.process.form</field>
        <field name="model">pan.sl.process</field>
        <field name="arch" type="xml">
            <form string="Process">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Handle a quotation"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="chain_id"/>
                        </group>
                        <group>
                            <field name="owner_role_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Activities" name="activities">
                            <field name="activity_ids" context="{'default_process_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="role_id"/>
                                    <field name="phase_id"/>
                                    <field name="choice_state" widget="badge"
                                           decoration-warning="choice_state != 'fixed'"
                                           decoration-success="choice_state == 'fixed'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pan_sl_process_search" model="ir.ui.view">
        <field name="name">pan.sl.process.search</field>
        <field name="model">pan.sl.process</field>
        <field name="arch" type="xml">
            <search string="Processes">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="chain_id"/>
                <field name="owner_role_id"/>
                <group>
                    <filter string="Chain" name="group_chain" context="{'group_by': 'chain_id'}"/>
                    <filter string="Owner role" name="group_owner_role" context="{'group_by': 'owner_role_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_process" model="ir.actions.act_window">
        <field name="name">Processes</field>
        <field name="res_model">pan.sl.process</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pan_sl_process_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a process</p>
        </field>
    </record>

    <!-- ===================== Activity (L3) ===================== -->

    <record id="view_pan_sl_activity_list" model="ir.ui.view">
        <field name="name">pan.sl.activity.list</field>
        <field name="model">pan.sl.activity</field>
        <field name="arch" type="xml">
            <list string="Activities">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="role_id"/>
                <field name="phase_id"/>
                <field name="choice_state" string="Choice" widget="badge"
                       decoration-warning="choice_state != 'fixed'"
                       decoration-success="choice_state == 'fixed'"/>
                <field name="rung_state" widget="badge"
                       decoration-muted="rung_state == '0'"
                       decoration-warning="rung_state in ('1', '2')"
                       decoration-success="rung_state in ('3', '4', '5')"/>
            </list>
        </field>
    </record>

    <record id="view_pan_sl_activity_kanban" model="ir.ui.view">
        <field name="name">pan.sl.activity.kanban</field>
        <field name="model">pan.sl.activity</field>
        <field name="arch" type="xml">
            <kanban default_group_by="phase_id" group_create="false" group_delete="false" group_edit="false">
                <field name="choice_state"/>
                <field name="open_point"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <field name="code" class="text-muted small"/>
                        </div>
                        <field name="process_id" class="text-muted"/>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <field name="role_id"/>
                            <field name="choice_state" widget="badge"
                                   decoration-warning="choice_state != 'fixed'"
                                   decoration-success="choice_state == 'fixed'"/>
                        </div>
                        <div class="mt-1">
                            <field name="rung_state" widget="badge"
                                   decoration-muted="rung_state == '0'"
                                   decoration-warning="rung_state in ('1', '2')"
                                   decoration-success="rung_state in ('3', '4', '5')"/>
                        </div>
                        <div t-if="record.open_point.raw_value" class="small text-warning mt-1">
                            <i class="fa fa-question-circle" title="Open point"/> Open point
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_pan_sl_activity_form" model="ir.ui.view">
        <field name="name">pan.sl.activity.form</field>
        <field name="model">pan.sl.activity</field>
        <field name="arch" type="xml">
            <form string="Activity">
                <header>
                    <field name="choice_state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Confirm the sales order"/></h1>
                    </div>
                    <group>
                        <group string="Business">
                            <field name="code"/>
                            <field name="process_id"/>
                            <field name="chain_id"/>
                        </group>
                        <group string="Map">
                            <field name="role_id"/>
                            <field name="phase_id"/>
                            <field name="model_id" options="{'no_create': True}"
                                   groups="pan_self_learning_blueprint.group_blueprint_manager"/>
                            <field name="model_name"
                                   groups="!pan_self_learning_blueprint.group_blueprint_manager"/>
                            <field name="rung_state" widget="badge"
                                   decoration-muted="rung_state == '0'"
                                   decoration-warning="rung_state in ('1', '2')"
                                   decoration-success="rung_state in ('3', '4', '5')"/>
                            <field name="planned_hours" widget="float_time"/>
                            <field name="spent_hours" widget="float_time"/>
                        </group>
                    </group>
                    <group>
                        <field name="open_point" string="Open point" placeholder="What still has to be checked or decided?"/>
                    </group>
                    <notebook>
                        <page string="Click path" name="click_path">
                            <field name="click_path" placeholder="The steps in Odoo, one per line."/>
                        </page>
                        <page string="Scenarios" name="scenarios">
                            <field name="scenario_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="progress" widget="progressbar"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids" readonly="1" context="{'active_test': False}">
                                <list>
                                    <field name="name"/>
                                    <field name="project_id"/>
                                    <field name="user_ids" widget="many2many_avatar_user"/>
                                    <field name="stage_id"/>
                                    <field name="pan_rung" widget="badge"
                                           decoration-muted="pan_rung == '0'"
                                           decoration-warning="pan_rung in ('1', '2')"
                                           decoration-success="pan_rung in ('3', '4', '5')"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pan_sl_activity_search" model="ir.ui.view">
        <field name="name">pan.sl.activity.search</field>
        <field name="model">pan.sl.activity</field>
        <field name="arch" type="xml">
            <search string="Activities">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="process_id"/>
                <field name="chain_id"/>
                <field name="phase_id"/>
                <field name="role_id"/>
                <field name="model_name"/>
                <field name="scenario_ids"/>
                <separator/>
                <filter string="Proposal" name="filter_proposal" domain="[('choice_state', '=', 'proposal')]"/>
                <filter string="Provisional" name="filter_provisional" domain="[('choice_state', '=', 'provisional')]"/>
                <filter string="Fixed" name="filter_fixed" domain="[('choice_state', '=', 'fixed')]"/>
                <filter string="Revised" name="filter_revised" domain="[('choice_state', '=', 'revised')]"/>
                <separator/>
                <filter string="Not live" name="filter_not_live" domain="[('rung_state', '!=', '5')]"/>
                <filter string="With open point" name="filter_open_point" domain="[('open_point', '!=', False)]"/>
                <filter string="External role" name="filter_external_role" domain="[('role_id.is_external', '=', True)]"/>
                <group>
                    <filter string="Chain" name="group_chain" context="{'group_by': 'chain_id'}"/>
                    <filter string="Process" name="group_process" context="{'group_by': 'process_id'}"/>
                    <filter string="Phase" name="group_phase" context="{'group_by': 'phase_id'}"/>
                    <filter string="Role" name="group_role" context="{'group_by': 'role_id'}"/>
                    <filter string="Choice" name="group_choice_state" context="{'group_by': 'choice_state'}"/>
                    <filter string="Progress" name="group_rung_state" context="{'group_by': 'rung_state'}"/>
                </group>
                <searchpanel>
                    <field name="chain_id" icon="fa-sitemap" enable_counters="1"/>
                    <field name="role_id" icon="fa-user" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_activity" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">pan.sl.activity</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_pan_sl_activity_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an activity</p>
        </field>
    </record>

</odoo>
