<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- One place to start: Projects > Map, a plain list of the projects
         with the map on (the switch under a project's Settings). -->
    <menuitem
        id="menu_blueprint_map"
        name="Map"
        parent="project.menu_main_pm"
        action="action_blueprint_map"
        groups="group_blueprint_user"
        sequence="3"/>

    <!-- What the maps share or need besides tasks: Projects > Configuration. -->
    <menuitem id="menu_blueprint_phase" name="Phases" parent="project.menu_project_config"
              action="action_phase" groups="group_blueprint_user" sequence="60"/>
    <menuitem id="menu_blueprint_role" name="Roles" parent="project.menu_project_config"
              action="action_role" groups="group_blueprint_user" sequence="61"/>
    <menuitem id="menu_blueprint_adkar_score" name="ADKAR scores" parent="project.menu_project_config"
              action="action_adkar_score" groups="group_blueprint_user" sequence="62"/>

</odoo>
