<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- One place to start: Projects > Map. With one mapped project it opens
         that map; with more, the map shows a plain list of them. -->
    <menuitem
        id="menu_blueprint_map"
        name="Map"
        parent="project.menu_main_pm"
        action="action_blueprint_map"
        groups="project.group_project_user"
        sequence="3"/>

    <!-- What the maps share or need besides tasks: Projects > Configuration. -->
    <menuitem id="menu_blueprint_phase" name="Phases" parent="project.menu_project_config"
              action="action_phase" groups="project.group_project_user" sequence="60"/>
    <menuitem id="menu_blueprint_role" name="Roles" parent="project.menu_project_config"
              action="action_role" groups="project.group_project_user" sequence="61"/>
    <menuitem id="menu_blueprint_adkar_score" name="ADKAR scores" parent="project.menu_project_config"
              action="action_adkar_score" groups="project.group_project_user" sequence="62"/>

</odoo>
