<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_blueprint_import_form" model="ir.ui.view">
        <field name="name">pan.sl.blueprint.wizard.import.form</field>
        <field name="model">pan.sl.blueprint.wizard</field>
        <field name="arch" type="xml">
            <form string="Import file">
                <group>
                    <field name="file" filename="filename" required="1"
                           options="{'accepted_file_extensions': '.json'}"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <!-- Hidden until a file is chosen: the upload button is the primary action before that. -->
                    <button name="action_import" string="Import file" type="object" class="btn-primary"
                            invisible="not file"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_blueprint_import" model="ir.actions.act_window">
        <field name="name">Import file</field>
        <field name="res_model">pan.sl.blueprint.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_blueprint_import_form"/>
        <field name="target">new</field>
        <field name="group_ids" eval="[Command.set([ref('group_blueprint_manager')])]"/>
    </record>

    <record id="action_blueprint_load_template" model="ir.actions.server">
        <field name="name">Load template</field>
        <field name="model_id" ref="model_pan_sl_blueprint"/>
        <field name="group_ids" eval="[Command.set([ref('group_blueprint_manager')])]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_load_template()</field>
    </record>

    <record id="action_blueprint_export" model="ir.actions.server">
        <field name="name">Export</field>
        <field name="model_id" ref="model_pan_sl_blueprint"/>
        <field name="group_ids" eval="[Command.set([ref('group_blueprint_manager')])]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_export()</field>
    </record>
</odoo>
