<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Import dialog, opened by "Import" on the project form. -->
    <record id="view_blueprint_import_form" model="ir.ui.view">
        <field name="name">pan.sl.blueprint.wizard.import.form</field>
        <field name="model">pan.sl.blueprint.wizard</field>
        <field name="arch" type="xml">
            <form string="Import blueprint">
                <group>
                    <field name="project_id" invisible="1"/>
                    <field name="file" filename="filename" required="1"
                           options="{'accepted_file_extensions': '.json'}"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"
                            invisible="not file"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
