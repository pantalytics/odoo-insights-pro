<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_blueprint_wizard_form" model="ir.ui.view">
        <field name="name">pan.sl.blueprint.wizard.form</field>
        <field name="model">pan.sl.blueprint.wizard</field>
        <field name="arch" type="xml">
            <form string="Blueprint import / export">
                <sheet>
                    <div class="text-muted mb-3">
                        A blueprint is one open JSON file with the chains, phases, roles, processes,
                        activities and scenarios of a company. Records are matched on their code:
                        importing again updates them, nothing is deleted. People and ADKAR scores
                        are not part of a blueprint.
                    </div>
                    <group>
                        <field name="mode" widget="radio" options="{'horizontal': true}"/>
                        <field name="file" filename="filename" invisible="mode != 'import'" required="mode == 'import'"/>
                        <field name="filename" invisible="1"/>
                        <field name="template" widget="radio" invisible="mode != 'template'" required="mode == 'template'"/>
                    </group>
                    <div class="text-muted" invisible="mode != 'import'">
                        The import is strict: a file that names an Odoo model of an app that is not
                        installed is refused, with the missing models listed.
                    </div>
                    <div class="text-muted" invisible="mode != 'template'">
                        Templates are written for a full installation. Models of apps that are not
                        installed are skipped: the records are imported without that model link and
                        the result lists the apps to install. Loading a template again only adds what
                        is missing and fills empty links; your own choices, click paths, open points
                        and scenario steps are kept.
                    </div>
                    <div class="text-muted" invisible="mode != 'export'">
                        Downloads the current model as blueprint.json.
                    </div>
                    <div class="alert alert-success mt-3 mb-2" role="status" invisible="not result">
                        <field name="result" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2" role="alert"
                         invisible="not warning">
                        <field name="warning" nolabel="1" class="flex-grow-1"/>
                        <button name="%(base.open_module_tree)d" type="action" string="Open Apps"
                                icon="fa-th-large" class="btn btn-secondary" groups="base.group_system"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"
                            invisible="mode != 'import'"/>
                    <button name="action_load_template" string="Load template" type="object" class="btn-primary"
                            invisible="mode != 'template'"/>
                    <button name="action_export" string="Export" type="object" class="btn-primary"
                            invisible="mode != 'export'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_blueprint_wizard" model="ir.actions.act_window">
        <field name="name">Import / export blueprint</field>
        <field name="res_model">pan.sl.blueprint.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_blueprint_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
